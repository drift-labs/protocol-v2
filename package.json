	"scripts": {
		"generate-docs": "typedoc --skipErrorChecking --logLevel Error",
		"prepare": "husky install",
		"prettify": "prettier --check './packages/*/src/**/*.ts' './apps/*/src/**/*.ts' './tests/**/*.ts'",
		"prettify:fix": "prettier --write './packages/*/src/**/*.ts' './apps/*/src/**/*.ts' './tests/**/*.ts'",
		"lint": "eslint . --ext ts --quiet --format unix",
		"lint:fix": "eslint . --ext ts --fix",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"bench:native-cu": "RUST_LOG=error ts-mocha -t 1000000 ./tests/nativeCuBench.ts",
		"program:sync-idl": "cp target/idl/velocity.json packages/sdk/src/idl/velocity.json && cp target/types/velocity.ts packages/sdk/src/idl/velocity.ts",
		"program:build": "anchor build --skip-lint --ignore-keys -- --no-default-features --features no-entrypoint,anchor-test && bun run program:sync-idl",
		"program:build:devnet": "bash deploy-scripts/build-devnet.sh",
		"program:build:mainnet": "anchor build --skip-lint",
		"program:idl": "anchor idl build --skip-lint -p velocity -o target/idl/velocity.json -- --no-default-features --features no-entrypoint,anchor-test && cp target/idl/velocity.json packages/sdk/src/idl/velocity.json && anchor idl type packages/sdk/src/idl/velocity.json --out packages/sdk/src/idl/velocity.ts && bun run rust:idl-sync",
		"program:idl:vaults": "anchor idl build --skip-lint -p vaults -o packages/vaults-sdk/src/idl/vaults.json && anchor idl type packages/vaults-sdk/src/idl/vaults.json --out packages/vaults-sdk/src/types/vaults.ts && bun run prettify:fix",
		"rust:idl-sync": "[ -f rust/velocity-rs/res/velocity.json ] && cp target/idl/velocity.json rust/velocity-rs/res/velocity.json || true",
		"rust:build": "cargo build --locked --manifest-path rust/Cargo.toml"
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"engines": {
		"node": ">=12"
	},
	"resolutions": {
		"@opentelemetry/auto-instrumentations-node": "0.62.2",
		"@opentelemetry/api": "1.7.0",
		"@solana/web3.js": "1.98.0",
		"chalk": "4.1.2",
		"debug": "<4.4.2",
		"ansi-styles": "4.3.0",
		"supports-color": "7.2.0",
		"strip-ansi": "6.0.1",
		"ansi-regex": "5.0.1",
		"wrap-ansi": "7.0.0",
		"color-convert": "<3.1.1",
		"color-name": "<2.0.1",
		"color-string": "<2.1.1",
		"simple-swizzle": "<0.2.3",
		"is-arrayish": "<0.3.3",
		"slice-ansi": "3.0.0",
		"error-ex": "<1.3.3",
		"backslash": "<0.2.1",
		"chalk-template": "<1.1.1",
		"supports-hyperlinks": "<4.1.1",
		"has-ansi": "<6.0.1"
	},
	"overrides": {
