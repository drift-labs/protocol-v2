{
  "name": "@backend/realtime-archiver",
  "version": "1.0.0",
  "scripts": {
    "reprocess-na-market": "ts-node src/scripts/reprocess-market-with-symbol.ts",
    "replace-curated-partition": "ts-node src/scripts/replace-curated-analytics-partition.ts",
    "seed-ingestion-state": "ts-node src/scripts/seed-ingestion-state.ts",
    "inspect-queue": "ts-node src/scripts/queue-dlq-inspection.ts",
    "inspect-dlq": "ts-node src/scripts/record-dlq-inspection.ts",
    "archive": "ts-node src/archiver.ts",
    "async": "ts-node src/async-slot-ingestion.ts",
    "record-ingestion-local": "ts-node src/scripts/local-record-ingestion-worker.ts",
    "start-grpc": "ts-node src/grpc-ingestion.ts",
    "start-fumarole": "node esbuild.config.js && node dist/fumarole-ingestion.js",
    "start": "ts-node src/index.ts",
    "build": "bun run clean && node esbuild.config.js",
    "build:lambda": "bun run clean:lambda && node esbuild.lambda.config.js && cd dist-lambda && for f in *.js; do zip -j \"${f%.js}.zip\" \"$f\" > /dev/null; openssl dgst -sha256 -binary \"${f%.js}.zip\" | openssl base64 -A > \"${f%.js}.zip.sha256\"; done",
    "clean": "rm -rf dist",
    "clean:lambda": "rm -rf dist-lambda",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "typings": "dist/index.d.ts",
  "dependencies": {
    "@aws-sdk/client-dynamodb-streams": "^3.709.0",
    "@aws-sdk/client-lambda": "^3.712.0",
    "@backend/common": "*",
    "@backend/dynamodb": "*",
    "@backend/kinesis": "*",
    "@backend/s3": "*",
    "@backend/sqs": "*",
    "@coral-xyz/anchor": "npm:@anchor-lang/core@1.0.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.53.0",
    "@opentelemetry/sdk-metrics-base": "^0.31.0",
    "@solana/web3.js": "^1.95.3",
    "@triton-one/yellowstone-fumarole": "^0.2.3",
    "@triton-one/yellowstone-grpc": "5.0.2",
    "@types/express": "^4.17.21",
    "@velocity-exchange/sdk": "workspace:*",
    "@velocity-exchange/vaults-sdk": "workspace:*",
    "aws-lambda": "^1.0.7",
    "bottleneck": "^2.19.5",
    "csv-parse": "^5.6.0",
    "exponential-backoff": "^3.1.1",
    "express": "^4.21.0",
    "rpc-websockets": "7.11.0",
    "undici": "^6.19.8",
    "@aws-sdk/client-dynamodb": "^3.650.0",
    "@aws-sdk/util-dynamodb": "^3.650.0",
    "@backend/athena": "workspace:*",
    "@aws-sdk/client-kinesis": "^3.650.0",
    "rxjs": "^6.6.7",
    "@opentelemetry/sdk-metrics": "^1.26.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.6.5",
    "esbuild": "^0.25.0",
    "esbuild-plugin-tsc": "^0.4.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  },
  "private": true
}
