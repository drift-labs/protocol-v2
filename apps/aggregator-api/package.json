{
  "name": "@backend/aggregator-api",
  "version": "1.0.0",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "start": "yarn build && fastify start -l info dist/app.js",
    "build": "echo \"aggregator-api: build skipped — deployed from infrastructure-v3; consumed as source by notification-engine\"",
    "watch": "tsc -w",
    "dev": "yarn build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"yarn:watch\" \"yarn:dev:start\"",
    "build:lambda": "bun run clean:lambda && node esbuild.lambda.config.js && cd dist-lambda && for f in *.js; do zip -j \"${f%.js}.zip\" \"$f\" > /dev/null; openssl dgst -sha256 -binary \"${f%.js}.zip\" | openssl base64 -A > \"${f%.js}.zip.sha256\"; done",
    "clean": "rm -rf dist",
    "clean:lambda": "rm -rf dist-lambda",
    "dev:start": "fastify start -r ts-node/register/transpile-only --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.698.0",
    "@aws-sdk/client-s3": "~3.845.0",
    "@aws-sdk/client-sqs": "~3.845.0",
    "@aws-sdk/s3-request-presigner": "~3.845.0",
    "@backend/dynamodb": "*",
    "@backend/redis": "*",
    "@backend/s3": "*",
    "@fastify/autoload": "^6.0.0",
    "@fastify/aws-lambda": "^5.0.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@privy-io/server-auth": "^1.32.5",
    "@velocity-exchange/common": "^0.0.1",
    "@velocity-exchange/sdk": "workspace:*",
    "bs58": "^6.0.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.0.1",
    "fastify-plugin": "^5.0.0",
    "json2csv": "^6.0.0-alpha.2",
    "rpc-websockets": "7.11.0",
    "@backend/common": "workspace:*",
    "aws-lambda": "^1.0.7",
    "@solana/web3.js": "1.98.0",
    "@coral-xyz/anchor": "^0.29.0",
    "decimal.js": "^10.5.0",
