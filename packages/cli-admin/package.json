{
	"name": "@velocity-exchange/admin-cli",
	"version": "0.1.2",
	"description": "Velocity v2 admin CLI: rotate authority keys, pause markets, and route operations through a Squads V4 multisig.",
	"author": "velocity-exchange",
	"repository": {
		"type": "git",
		"url": "git@github.com:drift-labs/protocol-v2-shadow.git",
		"directory": "packages/cli-admin"
	},
	"license": "Apache-2.0",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"bin": {
		"velocity-admin": "lib/index.js"
	},
	"files": [
		"lib"
	],
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"velocity-exchange",
		"velocity",
		"admin",
		"cli",
		"squads"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"clean": "rm -rf lib",
		"build": "bun run clean && tsc -p tsconfig.json && chmod +x lib/index.js",
		"lint": "eslint './src/**/*.ts' --quiet --format unix",
		"prettify": "prettier --check './src/**/*.ts'",
		"prettify:fix": "prettier --write './src/**/*.ts'",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@coral-xyz/anchor": "0.32.1",
		"@velocity-exchange/sdk": "workspace:*",
		"@solana/web3.js": "1.73.2",
		"@sqds/multisig": "2.1.3",
		"commander": "12.1.0"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"eslint": "8.57.0",
		"typescript": "5.4.5"
	}
}
